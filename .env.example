ALBY_HUB_URL="http://localhost:8080"
AUTH_TOKEN="eyJhb..."

# Database (Prisma)
DATABASE_URL="file:./data/lncurl.db"

# ALBY CLOUD ONLY
#ALBY_HUB_URL="https://my.albyhub.com"
#ALBY_HUB_NAME="nwcxxxxxxxxxxx"
#ALBY_HUB_REGION="fra"

# use dev lightning addresses
#DEV=true

# Charge loop
CHARGE_AMOUNT_SATS=1
CHARGE_INTERVAL_MS=3600000
# New wallets are not charged until this grace period expires.
GRACE_PERIOD_SECS=3600

# Stable lncurl Nostr identity (64-char hex or nsec). Keep this secret stable.
NOSTR_PRIVATE_KEY=
# Optional comma-separated relays for the lncurl kind 0 profile. Wallet closure
# events are always published to the relays in each wallet's NWC URI.
NOSTR_RELAYS=
NOSTR_PUBLISH_RETRY_MS=60000

# Node info

# Blog image generation (PPQ AI API — https://ppq.ai)
PPQ_API_KEY=
